# F2 table editing (prompt 016 §3 Part 2, R-TBL-01…08): cells, keys, tools, grips, picker, TSV paste, data safety
write-file t1.tmp.md "Intro para.\n\n| Name | Qty |\n| --- | --- |\n| elma | 10 |\n| çilek | 2 |\n\nMiddle.\n\n|x|y|\n|-|-|\n|1|2|\n"
open t1.tmp.md
wait-idle
key f2
ui v2f-hash-mark
ui v2f-caret "4|Name"
wait-idle
assert table_cell == "0,0"
assert table_tools == 17
type "s"
wait-idle
assert buffer contains "| Names |"
key tab
wait-idle
assert table_cell == "0,1"
key shift+tab
wait-idle
assert table_cell == "0,0"
key return
wait-idle
assert table_cell == "1,0"
ui v2f-caret "4|çilek"
wait-idle
key tab
wait-idle
assert table_cell == "2,1"
key tab
wait-idle
assert table_cell == "3,0"
type "a|b"
key shift+return
type "c"
wait-idle
assert buffer contains "a\|b<br>c"
ui v2f-tool col-right
wait-idle
assert table_cell == "3,1"
ui v2f-table align-center
wait-idle
assert buffer contains ":---:"
ui v2f-caret "1|elma"
ui v2f-table sort-asc
wait-idle
assert buffer contains "| a\|b<br>c |       |     |\n| çilek"
key ctrl+z
wait-idle
assert buffer contains "| elma "
ui v2f-table row-down
wait-idle
ui v2f-grip col 0 1
wait-idle
assert table_cell != ""
ui v2f-grip row 1 3
wait-idle
assert buffer contains "|       | elma      | 10  |\n|       | a\|b<br>c |     |\n|       | çilek"
key ctrl+alt+up
key ctrl+alt+right
key ctrl+alt+left
wait-idle
assert buffer contains "|       | elma      | 10  |\n|       | çilek     | 2   |\n|       | a\|b<br>c |"
key up
wait-idle
assert table_cell == "1,1"
key ctrl+shift+backspace
wait-idle
assert buffer contains "| :---: | --------- | --- |\n|       | çilek     | 2   |\n|       | a\|b<br>c |"
key ctrl+t
wait-idle
assert table_picker == "3 × 3"
key escape
ui v2f-caret "0|Middle."
key ctrl+t
key right
wait-idle
assert table_picker == "3 × 4"
key return
wait-idle
assert table_picker == ""
assert table_cell == "0,0"
ui v2e-clip-text "p\tq\nr\ts\n"
key ctrl+v
wait-idle
assert buffer contains "| p "
ui v2f-caret "0|Intro para."
key end
ui v2e-clip-text "k\tl\nm\tn\n"
key ctrl+v
wait-idle
assert tsv_offer == 1
ui v2f-tsv-convert
wait-idle
assert buffer contains "| k "
key ctrl+s
wait-idle
assert file_changed_blocks == 3
assert buffer contains "Intro para.\n\n| k   | l   |\n| --- | --- |\n| m   | n   |\n\n| "
assert buffer contains "\n\n|x|y|\n|-|-|\n|1|2|\n"
