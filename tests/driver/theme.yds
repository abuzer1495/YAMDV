# Scheme and mode through the context-menu commands (prompt 005 §3.1, §3.4)
assert menu_items > 20
assert menu_checked contains GitHub
command mode dark
wait-idle
assert mode == dark
assert dark == 1
command scheme glacier
wait-idle
assert scheme == glacier
assert menu_checked contains Glacier
command mode light
wait-idle
assert dark == 0
command scheme github
command mode system
wait-idle
assert scheme == github
assert mode == system
