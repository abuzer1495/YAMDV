# V2-B settings panel (prompt 012 §5.2, FUT-31, B.8.1): ⚙ opens it, the keyboard reaches
# Reading, a toggle applies live and lands in settings.ini, Reset section, Esc closes, and the
# memory it used is given back (PWS within +0.1 MiB of the value before opening).
# The first open warms the process-wide caches (DirectWrite glyphs/fonts, heap segments) and
# takes the screenshot; the memory check covers the second open/close (V2-B fix: on CI the
# cold first open kept ~0.8 MiB of such caches, which is not panel memory).
command mode light
wait-idle
ui click settings
wait-idle
snapshot settings-general-light.png
key esc
wait-idle
ui mem-mark
assert settings == closed
ui click settings
wait-idle
assert settings == open
assert settings_section == general
assert settings_focus == search
# Search filters by label in the UI language.
type "font"
wait-idle
assert settings_rows >= 2
key ctrl+A
key backspace
wait-idle
# Tab → navigation; ↓ ×4 → Reading; → enters the rows.
key tab
assert settings_focus == nav
key down
key down
key down
key down
wait-idle
assert settings_section == reading
key right
key down
key down
key down
wait-idle
assert settings_focus == reading.code_line_numbers
assert code_line_numbers == 0
key space
wait-idle
assert code_line_numbers == 1
assert ini.reading.code_line_numbers == true
# Reset section: Ctrl+F → search box; Shift+Tab wraps to Close, Reset all, Reset section.
key ctrl+F
key shift+tab
key shift+tab
key shift+tab
wait-idle
assert settings_focus == reset-section
key enter
wait-idle
assert code_line_numbers == 0
assert ini.reading.code_line_numbers != true
# Esc closes; the panel is freed.
key esc
wait-idle
assert settings == closed
assert pws_delta_kib <= 102
# Ctrl+, and the Settings… command open it too.
key ctrl+,
wait-idle
assert settings == open
key ctrl+,
wait-idle
assert settings == closed
command settings-menu
wait-idle
assert settings == open
key esc
wait-idle
assert settings == closed
