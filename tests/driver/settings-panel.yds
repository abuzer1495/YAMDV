assert settings == closed
assert gdi_delta == 0
assert user_delta == 0
assert pws_delta_kib <= 306
# Ctrl+, and the Settings… command open it too.
key ctrl+,
wait-idle
assert settings == open
key ctrl+,
wait-idle
assert settings == closed
command settings-menu
wait-idle
assert settings == open
key esc
wait-idle
assert settings == closed
