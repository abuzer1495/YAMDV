# Window goldens (prompt 005 §4): run by `cargo xtask golden-shell` with an empty profile.
resize 1000 700
wait-idle
command mode light
wait-idle
snapshot welcome-install-light.png
open ../../driver/a.md
wait-idle
snapshot doc-sidebar-light.png
command mode dark
wait-idle
snapshot doc-sidebar-dark.png
command mode light
key ctrl+F
type "target"
wait-idle
snapshot find-light.png
key esc
command scheme glacier
wait-idle
snapshot glacier-light.png
command scheme default
wait-idle
# V1-B (prompt 006 §2.7): Split Edit, and Live Edit with an active source block.
key f3
wait-idle
snapshot split-light.png
key f3
key f2
click-text "Paragraph 2 of filler"
wait-idle
snapshot live-block-light.png
key esc
key esc
command mode system
